<Window x:Class="Dependencies.SearchFolder"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Dependencies"
        mc:Ignorable="d"
        Title="Search folders customization" Height="400" Width="600">
    <Grid Margin="10" MinHeight="100" MinWidth="560">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Label Content="Binary current directory:" 
                   VerticalAlignment="Center"
                   Padding="0,0,8,0"
                   Grid.Column="0"
                   />

            <TextBox Text="{Binding Path=WorkingDirectory, Mode=OneWay}"
                    Name="WorkingDirectoryTextBox"
                    VerticalContentAlignment="Center"
                    MinHeight="23"
                    Grid.Column="1"
                    />

            <Button Content="..."
                    MinWidth="30"
                    MinHeight="23"
                    Margin="6,0,0,0"
                    Click="OnBinaryWorkindDirectoryChange"
                    Grid.Column="2"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Label Content="Additional search folders:" 
                   HorizontalAlignment="Left" 
                   Padding="0,0,0,4"
                   Grid.Row="0"
                   />

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ListBox ItemsSource="{Binding Path=SearchFolders}" 
                     Name="SearchFoldersList"
                     Margin="0" 
                     VerticalAlignment="Stretch"
                     VerticalContentAlignment="Stretch"
                     HorizontalContentAlignment="Stretch"
                     HorizontalAlignment="Stretch"
                     Width="auto" 
                     AllowDrop="True" 
                     Drop="SearchFolder_Drop" 
                     DragOver="SearchFolder_DragOver" 
                     DragLeave="SearchFolder_DragLeave" 
                     MouseDoubleClick ="SearchFoldersList_MouseDoubleClick"
                     SelectionChanged="OnSearchFolderViewSelectedItemChanged"
                     Background="{DynamicResource Theme.SearchFolderBackground}" 
                     FontSize="10"
                     Grid.Column="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <TextBlock Text="{Binding Path=Folder}"/>
                                <TextBox  Text="{Binding Path=Folder}" Visibility="{Binding IsEditable, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Column="1" Margin="8,0,0,0" MinWidth="90">
                    <StackPanel.Resources>
                        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="MinHeight" Value="23" />
                            <Setter Property="Padding" Value="10,1" />
                            <Setter Property="Margin" Value="0,0,0,6" />
                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                        </Style>
                    </StackPanel.Resources>

                    <Button Content="New" Click="OnNewEntry"/>
                    <Button Content="Edit" Click="OnEditEntry"/>
                    <Button Content="Browse ..." Click="OnBrowseEntry"/>
                    <Button Content="Delete" Click="OnDeleteEntry" Margin="0,0,0,18"/>
                    <Button Content="Move Up" Click="OnMoveUpEntry"/>
                    <Button Content="Move Down" Click="OnMoveDownEntry"/>
                </StackPanel>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="2"
                    Margin="0,10,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="OK" 
                    MinWidth="75"
                    MinHeight="23"
                    Padding="10,1"
                    IsDefault="True"
                    Click="OnValidate"/>

            <Button Content="Cancel" 
                    MinWidth="75"
                    MinHeight="23"
                    Padding="10,1"
                    Margin="8,0,0,0"
                    IsCancel="True"
                    Click="OnCancel"/>
        </StackPanel>
    </Grid>
</Window>
